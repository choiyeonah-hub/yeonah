    <!-- Accessibility service (shown in system Accessibility settings) -->
    <string name="a11y_service_label">원소잠금 앱 제한</string>
    <string name="a11y_service_summary">고른 앱이 열릴 때 원소 문제 화면을 띄워요.</string>
    <string name="a11y_service_description">원소잠금은 이 서비스로 지금 열린 앱의 패키지 이름만 확인해, 사용자가 직접 고른 앱이 열리면 원소 문제 화면을 띄웁니다. 화면 내용, 입력한 글자, 메시지는 읽거나 저장하지 않으며, 어떤 정보도 기기 밖으로 보내지 않습니다. 이 앱은 장애인 지원 앱이 아닙니다. 언제든 이 화면에서 끌 수 있습니다.</string>

    <!-- Prominent disclosure (Google Play AccessibilityService policy) -->
    <string name="disclosure_title">접근성 권한 사용 안내</string>
    <string name="disclosure_what">원소잠금은 Android 접근성 서비스 API를 사용해 \'지금 화면에 열린 앱의 패키지 이름\'(예: com.example.video)을 확인합니다.</string>
    <string name="disclosure_use">이 정보는 사용자가 고른 앱이 열렸는지 판단해 원소 문제 화면을 띄우는 데에만 씁니다.</string>
    <string name="disclosure_not">화면에 보이는 내용, 입력한 글자, 메시지, 비밀번호는 읽지 않고 저장하지도 않습니다. 앱이 사용자를 대신해 화면을 조작하지 않습니다.</string>
    <string name="disclosure_share">패키지 이름을 포함한 어떤 정보도 저장·수집하거나 기기 밖으로 보내지 않습니다. 원소잠금에는 인터넷 권한이 없습니다.</string>
    <string name="disclosure_off">전화, 긴급전화, 설정, 홈 화면은 제한하지 않습니다. 설정 &gt; 접근성에서 언제든 끌 수 있고, 끄면 앱 제한이 멈춥니다.</string>
    <string name="disclosure_agree">동의하고 접근성 설정 열기</string>
    <string name="disclosure_decline">동의하지 않음 (자유 학습만 하기)</string>

    <!-- Block screen -->
    <string name="block_title">원소잠금</string>
    <string name="block_body">이 앱은 지금 제한 중이에요. 원소 문제 1개를 맞히면 고른 앱을 %1$d분 동안 쓸 수 있어요.</string>
    <string name="block_phone_note">전화와 긴급전화는 제한되지 않아요.</string>
    <string name="block_solve">원소 문제 풀기</string>
    <string name="block_home">홈 화면으로</string>

    <!-- Onboarding -->
    <string name="onboarding_intro_title">폰을 열기 전에 원소 하나</string>
    <string name="onboarding_intro_1">유튜브·SNS·게임처럼 직접 고른 앱을 원소잠금이 제한해요.</string>
    <string name="onboarding_intro_2">원소잠금에서 주기율표 문제 1개를 맞히면</string>
    <string name="onboarding_intro_3">고른 앱 전체를 %1$d분 동안 쓸 수 있어요. 시간은 정답을 맞힌 순간부터 흘러요.</string>
    <string name="onboarding_intro_4">시간이 끝나면 다시 제한돼요. 틀린 원소는 더 자주 복습해요.</string>
    <string name="onboarding_intro_note">휴대폰 잠금화면이나 PIN·지문 인증을 대신하지 않아요. 언제든 설정에서 제한을 끌 수 있어요.</string>
    <string name="onboarding_range_title">학습 범위</string>
    <string name="onboarding_range_body">어떤 원소부터 익힐까요? 처음이라면 1~20번을 추천해요.</string>
    <string name="onboarding_range_later">설정에서 원소를 하나씩 골라 범위를 바꿀 수 있어요.</string>
    <string name="onboarding_permission_title">앱 제한 설정</string>
    <string name="onboarding_permission_body">고른 앱이 열릴 때 문제 화면을 띄우려면 접근성 권한이 필요해요. 다음 화면에서 무엇을 확인하고 무엇을 하지 않는지 먼저 알려 드릴게요.</string>
    <string name="onboarding_permission_step1">1. 접근성 권한 켜기</string>
    <string name="onboarding_permission_step2">2. 제한할 앱 고르기</string>
    <string name="onboarding_permission_request">접근성 권한 안내 보기</string>
    <string name="onboarding_permission_pick">앱 고르기</string>
    <string name="onboarding_battery_note">일부 제조사 기기는 배터리 절약 기능이 접근성 서비스를 멈출 수 있어요. 홈 화면에 \'확인이 필요해요\'가 보이면 배터리 설정에서 원소잠금을 \'제한 없음\'으로 바꿔 주세요.</string>
    <string name="onboarding_start">제한 시작하기</string>
    <string name="onboarding_learn_only">제한 없이 자유 학습만 하기</string>

