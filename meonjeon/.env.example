# ⚠️ 이 파일의 값은 전부 예시입니다. 그대로 쓰면 앱이 동작하지 않습니다.
#    Vercel → Settings → Environment Variables 에 실제 값을 넣으세요.
#    (Vercel이 이 파일을 읽어 예시 값을 자동으로 넣어두는 경우가 있으니,
#     배포 전에 값이 진짜인지 반드시 확인하세요.)
#
# ── 어디까지 넣어야 무엇이 되는가 ────────────────────────
#   ① 로그인·저장    SUPABASE_URL · SUPABASE_ANON_KEY
#   ② AI 정리        + ANTHROPIC_API_KEY
#   ③ 부모 폰 알림   + VAPID_* · SUPABASE_SERVICE_KEY
#   ④ 어른께 전화    + SOLAPI_* · CRON_SECRET
# 위에서부터 차례로 채우시면 됩니다. 아래 것이 비어도 위의 것은 돕니다.


# ═══ ① 로그인·저장 ═══════════════════════════════════════
# Supabase → Project Settings → API
# URL은 https://<프로젝트ID>.supabase.co 형태입니다.
SUPABASE_URL=

# anon / public 키 (eyJ 로 시작하는 수백 글자).
SUPABASE_ANON_KEY=


# ═══ ② AI 정리 ═══════════════════════════════════════════
# console.anthropic.com → API Keys. sk-ant-api03- 로 시작합니다.
# 서버에서만 쓰이고 브라우저로 내려가지 않습니다.
ANTHROPIC_API_KEY=

# 계정에 연결된(identity-linked) 키를 쓸 때만 필요합니다.
# 워크스페이스에 묶인 키를 만들면 비워두셔도 됩니다.
ANTHROPIC_WORKSPACE_ID=


# ═══ ③ 부모 폰 알림 (웹 푸시) ════════════════════════════
# npx web-push generate-vapid-keys 로 한 쌍을 만듭니다. 한 번만 만들고 바꾸지 마세요 —
# 바꾸면 이미 알림을 켜둔 폰들이 전부 끊깁니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 알림이 막혔을 때 브라우저 회사가 연락할 곳. mailto: 로 시작합니다.
VAPID_SUBJECT=mailto:

# ⚠ service_role 키. 모든 보안 규칙을 무시합니다.
#   api/push-send.js 와 api/voice-send.js 에서만 씁니다 — 모든 가구를 읽어야 하니까요.
#   브라우저에는 절대 안 내려갑니다. 다른 곳에는 쓰지 마세요.
SUPABASE_SERVICE_KEY=


# ═══ ④ 어른께 전화·문자 (솔라피) ═════════════════════════
# 솔라피 콘솔 → 개발 → API Key 관리 → 새로운 API KEY
# SECRET은 만들 때 한 번만 보입니다. 놓치면 재생성해야 합니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 발신번호. 솔라피에 등록·인증이 끝난 번호만 됩니다. 하이픈 없이 숫자만.
# 어른 폰에는 이 번호가 뜹니다 — 어른 폰에 "손주한통"으로 저장해두셔야 합니다.
# 나중에 다른 번호로 바꾸실 때 이 값만 갈면 됩니다. 코드는 안 건드립니다.
SOLAPI_FROM=

# /api/voice-send 와 /api/push-send 를 바깥에서 깨울 때 쓰는 암호.
# 아무나 못 맞출 긴 글자로 직접 정하세요(32자 이상). 아무 데도 적어두지 마세요.
# 스케줄러(cron-job.org 등)에 헤더로 넣습니다:  Authorization: Bearer <이 값>
CRON_SECRET=


# ═══ 시험용 (평소에는 비워두세요) ════════════════════════
# /api/voice-test 를 부를 때 쓰는 암호와, 시험 전화를 받을 번호.
# 한 통 걸어보고 나면 지우시는 편이 안전합니다.
VOICE_TEST_TOKEN=
VOICE_TEST_TO=

# 솔라피가 발송 결과를 돌려줄 때 확인하는 암호(웹훅).
VOICE_HOOK_TOKEN=
