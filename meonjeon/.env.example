# ⚠️ 이 파일의 값은 전부 예시입니다. 그대로 쓰면 앱이 동작하지 않습니다.
#    Vercel → Settings → Environment Variables 에 실제 값을 넣으세요.
#    (Vercel이 이 파일을 읽어 예시 값을 자동으로 넣어두는 경우가 있으니,
#     배포 전에 세 값이 진짜인지 반드시 확인하세요.)

# Anthropic API 키 — 서버에서만 쓰이고 브라우저로 내려가지 않습니다.
# console.anthropic.com → API Keys 에서 발급. sk-ant-api03- 로 시작합니다.
ANTHROPIC_API_KEY=

# 계정에 연결된(identity-linked) 키를 쓸 때만 필요합니다.
# console.anthropic.com → Settings → Workspaces 에서 워크스페이스 ID를 확인하세요.
# 워크스페이스에 묶인 키를 만들면 이 값은 비워두셔도 됩니다.
ANTHROPIC_WORKSPACE_ID=

# Supabase — 프로젝트 대시보드 → Project Settings → API
# URL은 https://<프로젝트ID>.supabase.co 형태입니다.
SUPABASE_URL=

# anon / public 키 (eyJ 로 시작하는 수백 글자).
# service_role 키는 절대 쓰지 마세요 — 모든 보안 규칙을 무시합니다.
SUPABASE_ANON_KEY=
