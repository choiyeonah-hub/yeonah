generator client {
  provider = "prisma-client-js"
}

// Vercel Postgres(Neon)의 Storage 연동을 켜면 아래 두 환경변수가 자동으로 주입된다.
// 로컬 개발은 docker-compose의 postgres 서비스를 가리키면 된다(README 참고).
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// 가족 단위. code로 서로 다른 기기에서 연동(참여)한다.
model Family {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  createdAt DateTime     @default(now())
  members   Member[]
  sessions  DaySession[]
}

// 가족 구성원. birthYear로 나이대(질문 층위)를 계산한다.
model Member {
  id        String    @id @default(cuid())
  familyId  String
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname  String
  birthYear Int?
  role      String // "parent" | "child"
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([familyId])
}

// 하루 단위 하브루타 세션. 가족당 하루에 하나.
model DaySession {
  id            String    @id @default(cuid())
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (KST 기준)
  topic         String? // 오늘의 주제 요약
  topicImageUrl String? @db.Text // AI 무작위 이미지 주제일 때 base64 data URL (서버리스 환경엔 디스크에 못 쓰므로 DB에 저장)
  topicSource   String    @default("user") // "user" | "ai-random"
  messages      Message[]
  createdAt     DateTime  @default(now())

  @@unique([familyId, date])
  @@index([familyId])
}

// 대화 메시지. role=user는 가족의 이야기/답변, role=ai는 하브루타 꼬리질문.
model Message {
  id         String     @id @default(cuid())
  sessionId  String
  session    DaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId   String?
  member     Member?    @relation(fields: [memberId], references: [id])
  role       String // "user" | "ai"
  content    String
  depthLevel Int? // 1~5, role=ai(질문)일 때만 채워짐
  depthLabel String? // 예: "사실 확인", "가치 판단"
  createdAt  DateTime   @default(now())

  @@index([sessionId])
  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────
// 안경 추천 앱 (아이핏 / EyeFit)
//
// 개인정보 설계 원칙:
//  - 얼굴 사진 원본과 처방전 이미지 원본은 절대 저장하지 않는다.
//    (요청 처리 중 메모리에서만 사용하고 응답 후 폐기)
//  - 얼굴 분석 결과는 "얼굴형/비율" 같은 파생 수치만 남긴다.
//  - 도수(처방 정보)는 민감정보이므로, 사용자가 매장 예약을 확정하며
//    별도 동의(sensitiveConsent)를 준 경우에만 저장한다.
// ─────────────────────────────────────────────────────────────

// 매장 예약(견적 요청). 앱에서 결제하지 않는다.
// 의료기사법상 도수 안경은 전자상거래 판매가 불가하므로,
// 최종 검안·조제·피팅은 매장의 안경사가 담당한다.
model FitReservation {
  id   String @id @default(cuid())
  code String @unique // 매장에 보여주는 6자리 예약 코드

  // 얼굴 분석 파생 결과 (원본 사진은 저장하지 않음)
  faceShape     String? // "oval" | "round" | ...
  faceSummary   String? @db.Text
  faceMetrics   Json? // widthToHeight, jawline, noseBridge 등 파생 수치

  // 선택한 테 / 렌즈
  frameId     String
  lensIndex   String // "1.56" | "1.60" | "1.67" | "1.74"
  lensOptions String[] // 코팅/기능 옵션 id 목록

  // 도수. sensitiveConsent가 true일 때만 채워진다.
  prescription     Json?
  sensitiveConsent Boolean @default(false)

  // 매장 / 견적
  storeId    String
  framePrice Int
  lensPrice  Int
  totalPrice Int

  // 연락처 (예약 확인용 최소 정보)
  contactName  String
  contactPhone String

  status    String   @default("requested") // requested | confirmed | done | canceled
  createdAt DateTime @default(now())

  @@index([storeId])
}
