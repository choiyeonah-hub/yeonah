generator client {
  provider = "prisma-client-js"
}

// Vercel Postgres(Neon)의 Storage 연동을 켜면 아래 두 환경변수가 자동으로 주입된다.
// 로컬 개발은 docker-compose의 postgres 서비스(5433)를 가리키면 된다.
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────────────────────
// 개인정보 설계 원칙
//
// 이 앱은 도수를 저장하지 않는다. 처방전 이미지도, 판독한 숫자도 남기지 않는다.
// 도수는 개인정보보호법상 민감정보라 저장하는 순간 별도 동의와 관리 의무가
// 생기는데, 이 도구의 목적(렌즈 값이 적정한지 판단)에는 도수가 필요 없다.
// 계산은 브라우저를 떠나지 않고, 남는 건 아래 "얼마 냈는지" 제보뿐이다.
// ─────────────────────────────────────────────────────────────

// 사용자가 실제로 지불한 렌즈 값 제보.
// 제휴 안경원 없이 가격 데이터를 모으는 유일한 방법이고, 이 앱의 자산이다.
model LensQuoteReport {
  id String @id @default(cuid())

  region    String // "서울", "경기", ...
  storeKind String // "체인" | "동네" | "온라인/기타"

  lensIndex   String // "1.56" | "1.60" | "1.67" | "1.74"
  lensOptions String[]
  progressive Boolean @default(false)

  /// 렌즈 값만(원). 테 값은 브랜드마다 달라 비교가 무의미해서 받지 않는다.
  lensPrice Int

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([region, lensIndex])
  @@index([lensIndex])
}
