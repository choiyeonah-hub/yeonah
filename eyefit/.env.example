# Postgres 접속 정보.
# - Vercel: 프로젝트 Storage 탭에서 Postgres를 연결하면 아래 두 값이 자동으로 채워집니다.
# - 로컬 개발: docker-compose.yml로 띄운 Postgres를 그대로 쓰면 됩니다(README 참고).
POSTGRES_PRISMA_URL="postgresql://eyefit:eyefit@localhost:5433/eyefit?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://eyefit:eyefit@localhost:5433/eyefit"

# OpenAI API key (서버에서만 사용, 브라우저에 노출되지 않음)
# 용도: 얼굴 비율 측정, 안경 처방전 판독
OPENAI_API_KEY="sk-..."

# 비전 모델 (선택). gpt-4o-mini도 이미지 입력을 지원합니다.
OPENAI_VISION_MODEL="gpt-4o-mini"
