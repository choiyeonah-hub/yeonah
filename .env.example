# Postgres 접속 정보.
# - Vercel: 프로젝트의 Storage 탭에서 Postgres를 연결하면 아래 두 값이 자동으로 채워집니다.
# - 로컬 개발: docker-compose.yml로 띄운 Postgres를 그대로 써도 됩니다(README 참고).
POSTGRES_PRISMA_URL="postgresql://habruta:habruta@localhost:5432/habruta?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://habruta:habruta@localhost:5432/habruta"

# OpenAI API key (server-side only, never exposed to the browser)
# Used for: 하브루타 꼬리질문 생성, 나이대별 깊이 조절, 무작위 이미지 주제 생성
OPENAI_API_KEY="sk-..."

# Model overrides (optional)
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"
# 안경 추천 앱(아이핏)의 얼굴 비율 측정 / 처방전 판독에 쓰는 비전 모델.
# 비워두면 OPENAI_CHAT_MODEL을 그대로 씁니다(gpt-4o-mini도 이미지 입력을 지원).
OPENAI_VISION_MODEL="gpt-4o-mini"
