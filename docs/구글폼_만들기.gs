/* ─────────────────────────────────────────────────────────────
   먼저ON · 조부모 돌봄 — 모집 폼 한 벌 (16문항 · 3분)

   설문이 아니라 모집입니다. "쓰시겠어요?"는 묻지 않습니다.
   실제로 전화를 걸어볼 30집을 찾는 것이 전부입니다.

   쓰는 법
   1. script.google.com → "새 프로젝트"
   2. 편집기 안을 클릭 → Ctrl+A → Delete (있던 것을 다 지웁니다)
   3. 이 내용을 통째로 붙여넣기 → Ctrl+S (저장)
   4. 위쪽 "함수 없음" 자리를 눌러 makeForm 을 고르고 ▶ 실행
   5. 권한 허용 ("확인하지 않은 앱" 경고 → 고급 → 이동)
   6. 아래 실행 로그에 주소 두 개가 찍힙니다

   만든 뒤 손으로 하실 것 둘
   · 응답 → 스프레드시트 연결 (응답 탭 → 초록 아이콘)
   · 표지 색·이미지 (오른쪽 위 팔레트)
   ───────────────────────────────────────────────────────────── */

/* 도우미 ─────────────────────────────────────── */
function one(f, t, o, req)  { var q=f.addMultipleChoiceItem().setTitle(t).setChoiceValues(o); if(req!==false)q.setRequired(true); return q; }
function many(f, t, o, req) { var q=f.addCheckboxItem().setTitle(t).setChoiceValues(o);       if(req!==false)q.setRequired(true); return q; }
function short(f, t, req)   { var q=f.addTextItem().setTitle(t);          if(req)q.setRequired(true); return q; }
function head(f, t, h)      { var s=f.addSectionHeaderItem().setTitle(t); if(h)s.setHelpText(h); return s; }

function makeForm() {
  var f = FormApp.create('먼저ON 베타 참여 신청 — 조부모 돌봄');
  f.setTitle('먼저ON 베타 참여 신청')
   .setDescription(
     '어른께 아이를 맡기는 부모를 위한 앱입니다.\n' +
     '매일 아침 말씀드리지 않으셔도 되게, 요일 일정을 한 번 넣어두면\n' +
     '앱이 정해진 시각에 어른께 전화로 알려드립니다.\n' +
     '어른은 받기만 하시면 됩니다 — 앱을 깔지 않으셔도 됩니다.\n\n' +
     '돌 지난 아이(12개월)부터 초등 2학년까지가 대상입니다.\n\n' +
     '· 2분이면 끝납니다\n' +
     '· 완주하시면 커피 기프티콘 5,000원\n' +
     '· 선착순이 아니라 가구 형태를 보고 뽑습니다')
   .setCollectEmail(true).setProgressBar(true);

  /* 1 ─ 자격 */
  one(f, '아이를 할머니·할아버지(또는 다른 어른)께 맡기시나요?', [
    '정기적으로 맡깁니다 (매주)',
    '가끔 맡깁니다 (급할 때)',
    '곧 맡길 예정입니다 (복직 등)',
    '맡기지 않습니다']);

  /* 1-2 ─ 친정이냐 시가냐. 부탁을 얼마나 드리느냐가 여기서 갈릴 것 같습니다.
     친정엄마껜 편히 부탁하고 시어머니껜 말도 못 꺼내는 집이 있을 텐데,
     그게 사실이면 이 앱이 팔리는 자리도 갈립니다. 반드시 교차해서 봐야 합니다. */
  one(f, '주로 어느 쪽 어른께 맡기시나요?', [
    '친정 어머니·아버지',
    '시어머니·시아버지',
    '양쪽 다',
    '이모·고모·삼촌 등 다른 친인척',
    '돌보미·시터 선생님']);

  /* 2 ─ 빈도 */
  one(f, '얼마나 자주 맡기시나요?', [
    '주 5일 이상', '주 3~4일', '주 1~2일', '한 달에 몇 번', '아직 안 맡김']);

  /* 3 ─ 나이 */
  many(f, '자녀가 어느 나이에 해당하나요? (여러 명이면 모두)', [
    '돌 전 (0~11개월 · 대상 아님)',
    '12~23개월',
    '24~35개월',
    '만 3세',
    '만 4~5세 (유치원)',
    '초등 1~2학년',
    '초등 3학년 이상 (대상 아님)']);

  /* 3-2 ─ 요일마다 다른가 (핵심 자격) */
  one(f, '아이 일정이 요일마다 다른가요? (학원·수업·하원 시각 등)', [
    '요일마다 다르다',
    '거의 매일 같다',
    '정해진 일정이 없다']);

  /* 3-3 ─ 돌봄이 더 필요한 아이 */
  one(f, '자녀 중 발달·건강상 돌봄이 더 필요한 아이가 있나요?', [
    '있다',
    '없다',
    '말씀드리고 싶지 않다'], false);

  /* 4 ─ 지금 어떻게 */
  many(f, '지금 어른께 일정을 어떻게 전달하시나요? (여러 개 고르셔도 됩니다)', [
    '카톡으로 보낸다',
    '전화로 말한다',
    '종이에 적어드린다 · 냉장고에 붙여둔다',
    '전날 밤에 말씀드린다',
    '어른이 알아서 하신다',
    '따로 안 한다']);

  /* 5 ─ 어긋난 적 (핵심) */
  many(f, '전달이 어긋나서 곤란했던 적이 있나요? (여러 개 고르셔도 됩니다)', [
    '하원·하교 시각을 잘못 아셨다',
    '약을 안 먹였거나 잘못 먹였다',
    '준비물을 못 챙겨 보냈다',
    '먹이면 안 되는 것을 드렸다',
    '학원·병원 시간을 놓쳤다',
    '어른이 여쭤보시려 했는데 내가 전화를 못 받았다',
    '어긋난 적 없다']);

  /* 5-2 ─ 부모 쪽 부담. 이 앱이 실제로 덜어주는 것은 여기입니다 */
  one(f, '어른께 매일 일정을 전달하는 일이 부담스러우신가요?', [
    '매우 부담된다',
    '조금 부담된다',
    '별로 부담되지 않는다',
    '전혀 부담되지 않는다']);

  /* 5-3 ─ 어긋났을 때 누구 탓 같은지. 여기가 이 제품의 진짜 자리입니다 */
  one(f, '전달이 어긋났을 때 어떤 마음이 드셨나요? (해당 없으면 건너뛰세요)', [
    '내가 제대로 말 안 한 것 같아 미안했다',
    '어른께 죄송했다',
    '아이에게 미안했다',
    '어른께 서운했지만 말은 못 했다',
    '어긋난 적이 없다'], false);

  /* 6 ─ 어떻게 느끼시나 (핵심) */
  one(f, '앱이 어른께 대신 전화를 걸어 일정을 읽어드린다면 어떠실 것 같으세요?', [
    '좋겠다. 내가 매번 말 안 해도 되니까',
    '어른께 실례일 것 같다',
    '어른이 안 받으실 것 같다',
    '어른이 기계 목소리를 싫어하실 것 같다',
    '잘 모르겠다']);

  /* 6-2 ─ 몇 번 걸릴 것인가. 통 수가 곧 값이라, 이 답이 요금제를 정합니다 */
  one(f, '전화가 언제 오면 좋으실 것 같으세요?', [
    '아침에 한 번, 그날 것을 한꺼번에',
    '일정마다 그 시각 30분 전에 각각',
    '둘 다 — 아침에 한 번 듣고, 중요한 것은 그 시각에 한 번 더',
    '전화는 필요 없다']);

  /* 6-3 ─ 일정마다 걸리는 게 편한지 성가신지. 위 문항과 짝입니다 */
  one(f, '일정마다 그 시각에 맞춰 전화가 온다면 어떠실 것 같으세요?', [
    '편하겠다. 어른이 시계를 안 보셔도 되니까',
    '아침에 한 번이면 충분할 것 같다',
    '전화가 자주 오면 어른이 성가셔 하실 것 같다',
    '잘 모르겠다']);

  /* 6-4 ─ 이 제품이 3주 만에 죽는 방식. 지금 이미 일어나고 있는지를 봅니다.
     "안 받으신다"가 아니라 "안 들어도 안다"가 진짜 끝입니다. */
  one(f, '어른께서 "그건 말 안 해도 안다"고 하신 적이 있나요?', [
    '자주 그러신다',
    '가끔 그러신다',
    '거의 없다',
    '오히려 더 알려달라고 하신다'], false);

  /* 6-5 ─ 부탁. 일정(사실)과 다른 물건입니다.
     "3시 20분 태권도"는 앱이 읽어드려도 되지만
     "세탁소 옷 찾아주세요"는 앱이 읽으면 며느리가 시어머니께 하는 말이 됩니다.
     그래서 부탁은 전화가 아니라 문자로, 부모 이름으로 나가야 할 것 같은데,
     먼저 실제로 무엇을 부탁드리는지부터 알아야 합니다. */
  many(f, '아이 일정 말고, 어른께 따로 부탁드리는 것이 있나요? (여러 개 고르셔도 됩니다)', [
    '세탁소·수선집에 맡긴 것 찾기',
    '택배·배달 받아두기',
    '병원·약국에서 아이 약 타오기',
    '장보기 (아이 먹을 것)',
    '학원·병원에 아이 데려다주기',
    '집에 오는 사람(기사·검침) 받아주기',
    '은행·우체국·관공서 볼일',
    '부탁은 거의 안 드린다'], false);

  short(f, '그 밖에 자주 부탁드리는 것이 있으면 적어주세요.', false);

  /* 6-6 ─ 이게 진짜 문항입니다. 부탁을 못 꺼내는 집이 이 앱을 살지,
     아니면 앱이 대신 말해주는 걸 더 불편해할지. 둘 다 가능합니다. */
  one(f, '부탁드리고 싶은데 말을 못 꺼내신 적이 있나요?', [
    '자주 있다',
    '가끔 있다',
    '거의 없다 — 편히 말씀드린다',
    '부탁드릴 일이 없다']);

  /* 7 ─ 모르는 번호 (핵심) */
  one(f, '어른께서 모르는 번호로 오는 전화를 받으시나요?', [
    '대부분 받으신다',
    '저장된 번호만 받으신다',
    '거의 안 받으신다',
    '잘 모르겠다']);

  /* 7-2 ─ 어른이 앱을 쓰시나 — 원가가 여기서 갈립니다 */
  one(f, '어른께서 스마트폰으로 카톡이나 앱을 쓰시나요?', [
    '카톡도 하시고 앱도 잘 쓰신다',
    '카톡은 하시는데 새 앱은 어려워하신다',
    '전화만 쓰신다',
    '잘 모르겠다']);

  /* 8 ─ 어른 연세 */
  one(f, '어른 연세가 어떻게 되시나요? (두 분이면 주로 보시는 분)', [
    '60세 미만', '60대', '70대', '80대 이상']);

  /* 9 ─ 지역 */
  short(f, '사시는 지역을 적어주세요. (예: 서울 목동, 경기 수원)', true);

  /* 9-2 ─ 돌봄수당. 받는 집은 지불 의사가 다릅니다 */
  one(f, '지자체에서 조부모 돌봄수당(손주돌봄수당)을 받고 계신가요?', [
    '받고 있다',
    '신청했는데 아직이다',
    '대상인지 몰랐다',
    '대상이 아니다'], false);

  /* 10 ─ 참여 */
  head(f, '참여 조건',
       '4주 동안 실제로 어른께 전화가 갑니다.\n' +
       '중간에 카톡으로 두어 번 여쭙고, 끝나면 10분 통화를 부탁드립니다.\n' +
       '완주 시 커피 기프티콘 5,000원 · 정식 출시 후 유료 기능 6개월 무료');

  many(f, '아래를 확인해주세요. (모두 체크해주셔야 합니다)', [
    '4주 동안 써보고 피드백에 참여할 수 있습니다',
    '어른께 전화가 가는 것을 어른께도 미리 말씀드리겠습니다',
    '아이 이름·일정 등 적은 내용은 전화를 걸기 위해서만 쓰이고, 베타가 끝나면 지워지는 것을 이해합니다']);

  short(f, '연락받으실 휴대폰 번호', true);
  short(f, '어른 휴대폰 번호 (뽑히시면 이 번호로 전화가 갑니다)', false);

  var pub = f.getPublishedUrl(), edit = f.getEditUrl();
  Logger.log('───────────────────────────────');
  Logger.log('응답용 (참여자에게 보낼 주소): ' + pub);
  Logger.log('편집용 (연아님이 고칠 주소): ' + edit);
  Logger.log('───────────────────────────────');
  return { pub: pub, edit: edit };
}
